server {
    listen ${PORT};
    server_name localhost;
    server_tokens off;

    # Must exceed the 10 MiB backend upload cap (multer) or large contracts get HTTP 413.
    client_max_body_size 12m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        # Dynamic resolution: Railway reassigns private IPs on every backend
        # redeploy, and nginx caches proxy_pass hostnames resolved at startup.
        # A variable forces per-request resolution; ipv6=off avoids the
        # IPv4/IPv6 timeout fallback seen when the backend is IPv4-only.
        resolver ${RESOLVER} valid=10s ipv6=off;
        set $backend_upstream ${BACKEND_HOST}:${BACKEND_PORT};
        proxy_pass http://$backend_upstream;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
}
