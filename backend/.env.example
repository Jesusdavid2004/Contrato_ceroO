NODE_ENV=development
PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-me
DB_NAME=contratoclaro
DATABASE_URL=
JWT_SECRET=replace-with-a-random-secret-of-at-least-16-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CONTRACT_FILE_RETENTION=none
RAG_ENABLED=false
# To enable retrieval: npm run seed:legal (curated backend/data/legal/manifest.json -> per-domain files), then RAG_ENABLED=true.
EMBEDDING_CACHE_DIR=storage/models
# Optional Gemini key (free tier at https://aistudio.google.com/apikey).
# When set, Gemini refines low-confidence clauses and writes letters;
# the local model still classifies everything.
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_SMART=gemini-3.5-flash
# Explicit provider choice: gemini | local | fake. Empty = auto
# (fake in tests, hybrid local + Gemini when a key is set, otherwise local).
AI_PROVIDER=
# Stuck analysis jobs older than this are marked FAILED on startup.
ANALYSIS_JOB_TIMEOUT_MS=600000
# Demo seed is a manual development-only step and requires this flag.
SEED_DEMO=false
AI_MAX_TOKENS_CLASSIFICATION=8192
AI_REQUEST_TIMEOUT_MS=30000
DAILY_AI_QUOTA=20
CORS_ORIGIN=http://localhost:5173
GRPC_PORT=50051
GRPC_INTERNAL_TOKEN=dev-internal-token
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
