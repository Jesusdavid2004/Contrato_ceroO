NODE_ENV=development
PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-me
DB_NAME=contratoclaro
DATABASE_URL=
JWT_SECRET=replace-with-a-random-secret-of-at-least-16-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CONTRACT_FILE_RETENTION=none
RAG_ENABLED=false
EMBEDDING_CACHE_DIR=storage/models
# Optional. Empty = local neural AI (embeddings + local OCR), no external API.
ANTHROPIC_API_KEY=
# Explicit provider choice: anthropic | local | fake. Empty = auto
# (fake in tests, anthropic when a key is set, local otherwise).
AI_PROVIDER=
# Stuck analysis jobs older than this are marked FAILED on startup.
ANALYSIS_JOB_TIMEOUT_MS=600000
# Demo seed is a manual development-only step and requires this flag.
SEED_DEMO=false
AI_MODEL_FAST=claude-3-5-haiku-20241022
AI_MODEL_SMART=claude-3-5-sonnet-20241022
AI_MAX_TOKENS_CLASSIFICATION=8192
AI_REQUEST_TIMEOUT_MS=30000
DAILY_AI_QUOTA=20
CORS_ORIGIN=http://localhost:5173
GRPC_PORT=50051
GRPC_INTERNAL_TOKEN=dev-internal-token
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
