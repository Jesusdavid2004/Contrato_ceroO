# Local Docker Compose only. Never use these sample values in a deployed environment.
DB_PASSWORD=local-only-change-this-password
JWT_SECRET=local-only-change-this-secret
CORS_ORIGIN=http://localhost:8080
NODE_ENV=development
RAG_ENABLED=false
CONTRACT_FILE_RETENTION=none
# Optional. Empty = local neural AI (embeddings + local OCR), no external API.
# Paste a free Gemini key (https://aistudio.google.com/apikey) to enable the
# hosted smart tier; the local model still classifies everything.
GEMINI_API_KEY=
# Explicit provider choice: gemini | local | fake. Empty = auto.
AI_PROVIDER=local
DEMO_USER_EMAIL=demo@example.test
DEMO_USER_PASSWORD=
# Contract assistant (chat + guided walkthrough). With a Gemini key the hosted
# model answers; without one an offline extractive assistant quotes the analysis.
GEMINI_MODEL_ASSISTANT=gemini-3.5-flash
AI_MAX_TOKENS_ASSISTANT=900
ASSISTANT_DAILY_MESSAGES=60
# Legal radar: polls official sources for changes (every N minutes, minimum 5).
LEGAL_RADAR_ENABLED=true
LEGAL_RADAR_INTERVAL_MINUTES=60
